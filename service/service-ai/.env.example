# AI Service Environment Configuration
# All AI provider credentials are SERVER-SIDE ONLY
# NEVER expose these through NEXT_PUBLIC_* or frontend code

NODE_ENV=development

# Service
PORT=3008
SERVICE_NAME=service-ai
LOG_LEVEL=info

# ============================================================
# AI Provider Configuration
# ============================================================
# Choose ONE provider: "openai" | "anthropic" | "local"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000

# Anthropic Configuration (alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_TIMEOUT_MS=30000

# Local LLM Configuration (e.g. Ollama)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_TIMEOUT_MS=60000

# ============================================================
# Inter-Service URLs (Docker DNS names)
# ============================================================
SVC_CONTENT_URL=http://svc-content:3004
SVC_BKT_URL=http://svc-bkt:3002
SVC_CLASS_URL=http://svc-class:3003
SVC_AUTH_URL=http://svc-auth:3001
SVC_EXAM_URL=http://svc-exam:3007

# ============================================================
# Generation Settings
# ============================================================
MAX_QUESTIONS_PER_REQUEST=20
MAX_PROMPT_TOKENS=4000
DEFAULT_QUESTION_COUNT=5

# ============================================================
# Consul / Service Discovery
# ============================================================
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ============================================================
# Observability
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
