{
  "name": "@verveai/service-ai",
  "version": "1.0.0",
  "description": "AI capability service for VERVE AI - generation, diagnostic, and recommendations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@verveai/common-node": "workspace:*",
    "@verveai/error-types": "workspace:*",
    "@verveai/circuit-breaker": "workspace:*",
    "express": "^4.18.2",
    "zod": "^3.22.4",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "tsx": "^4.6.2",
    "vitest": "^1.1.0",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
