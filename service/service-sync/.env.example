# Service Configuration
NODE_ENV=development
PORT=3005

# Service Identity
SERVICE_NAME=svc-sync
SERVICE_PORT=3005

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://verveai:verveai_dev_pass@localhost:5433/verveai?schema=sync

# Consul Service Discovery
CONSUL_HOST=localhost
CONSUL_PORT=8500

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=svc-sync
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
