NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/verveai_auth?schema=auth

# JWT
JWT_SECRET=your-256-bit-secret-min-32-chars!!
JWT_ISSUER=verveai
JWT_EXPIRES_IN=24h

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_NAME=svc-auth
SERVICE_PORT=3001
