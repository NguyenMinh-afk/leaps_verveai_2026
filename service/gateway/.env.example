PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# JWT
JWT_SECRET=your-256-bit-secret-min-32-chars!!
JWT_ISSUER=verveai

# Rate limiting
RATE_LIMIT_AUTH=100
RATE_LIMIT_API=1000
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGINS=http://localhost:3000,https://verveai.vercel.app

# Upstream services ( Consul resolves these at runtime, but Docker DNS fallback)
SVC_AUTH_URL=http://svc-auth:3001
SVC_BKT_URL=http://svc-bkt:3002
SVC_CLASS_URL=http://svc-class:3003
SVC_CONTENT_URL=http://svc-content:3004
SVC_SYNC_URL=http://svc-sync:3005
SVC_AI_URL=http://svc-ai:3008
