# Service BKT — Environment variables
# Copy to .env and adjust.

# --- HTTP ---
PORT=3002
NODE_ENV=development

# --- PostgreSQL (5-schema shared DB) ---
# Service uses only the `bkt` schema.
DATABASE_URL=postgresql://verveai:verveai@localhost:5432/verveai?schema=bkt

# --- Consul (Service Discovery) ---
CONSUL_HOST=localhost
CONSUL_PORT=8500

# --- JWT (issued by svc-auth; verified by Gateway, not by this service) ---
JWT_SECRET=replace-with-shared-secret

# --- OpenTelemetry / Jaeger ---
OTEL_SERVICE_NAME=svc-bkt
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Logging ---
LOG_LEVEL=info
