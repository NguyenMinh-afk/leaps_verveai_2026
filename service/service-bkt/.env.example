# Service Configuration
NODE_ENV=development
PORT=3002

# Service Identity
SERVICE_NAME=svc-bkt
SERVICE_PORT=3002

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://verveai:verveai_dev_pass@localhost:5433/verveai?schema=bkt

# Consul Service Discovery
CONSUL_HOST=localhost
CONSUL_PORT=8500

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=svc-bkt
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
