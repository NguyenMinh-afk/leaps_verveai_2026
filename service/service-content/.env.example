# Service Configuration
NODE_ENV=development
PORT=3004

# Service Identity
SERVICE_NAME=svc-content
SERVICE_PORT=3004

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://verveai:verveai_dev_pass@localhost:5433/verveai?schema=content

# Consul Service Discovery
CONSUL_HOST=localhost
CONSUL_PORT=8500

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=svc-content
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Ed25519 Key Storage (mounted as a Docker volume in production)
KEYS_DIR=/app/keys
