# ============================================================
# NEKOPATH — Environment Configuration Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# --- Application ---
VITE_APP_NAME="Nekopath"
VITE_APP_VERSION="1.0.0"

# --- Content ---
# Current content bundle version (semver)
VITE_CONTENT_VERSION="1.0.0"
# URL or path to content manifest (for auto-update)
VITE_CONTENT_MANIFEST_URL=""
# Enable content auto-update (when online)
VITE_CONTENT_AUTO_UPDATE="false"

# --- Sync Strategy (SC-05 / SC-06) ---
# Options: "auto" | "webrtc" | "file-exchange" | "cloud"
# - "auto": System detects and chooses best available strategy
# - "webrtc": Force WebRTC-only (in-class sync)
# - "file-exchange": Force file-exchange-only (USB/AirDrop)
# - "cloud": Cloud backup only (requires internet)
VITE_SYNC_STRATEGY="auto"

# --- WebRTC Signaling (SC-05) ---
# WebRTC signaling server URL for in-class sync
VITE_WEBRTC_SIGNAL_URL="ws://localhost:9000"
# Enable WebRTC in debug mode (logs peer connections)
VITE_WEBRTC_DEBUG="false"

# --- File Exchange (SC-06) ---
# Encryption key for evidence file export (AES-256)
# IMPORTANT: Change this to a strong random value in production!
# Generate with: openssl rand -hex 32
VITE_FILE_EXCHANGE_KEY=""
# File exchange metadata retention (days)
VITE_FILE_EXCHANGE_RETENTION_DAYS="30"

# --- Storage ---
# IndexedDB database name
VITE_DB_NAME="nekopath_db"
# IndexedDB version (increment on schema changes)
VITE_DB_VERSION="1"
# Maximum storage quota (bytes) - null = unlimited
VITE_STORAGE_QUOTA=""

# --- Privacy (BR-01–BR-20) ---
# Privacy mode: "strict" | "standard" | "minimal"
# - "strict": Anonymize all data, no PII stored
# - "standard": PII stored locally only, anonymized on sync
# - "minimal": Full PII stored (not recommended)
VITE_PRIVACY_MODE="strict"
# Minimum age for data retention (days)
VITE_DATA_RETENTION_DAYS="365"
# Enable data export/delete capability
VITE_ENABLE_DATA_EXPORT="true"
VITE_ENABLE_DATA_DELETE="true"

# --- Authentication ---
# Authentication mode: "offline" | "online" | "hybrid"
VITE_AUTH_MODE="offline"
# Session timeout (minutes)
VITE_SESSION_TIMEOUT="480"

# --- Device Identity ---
# Device ID (auto-generated on first run if empty)
VITE_DEVICE_ID=""
# Device role: "student" | "teacher" | "admin"
VITE_DEVICE_ROLE="student"

# --- Optional Features (Feature Flags) ---
# Enable cloud backup (requires VITE_SYNC_STRATEGY="cloud")
VITE_FEATURE_CLOUD_BACKUP="false"
# Enable content updater
VITE_FEATURE_CONTENT_UPDATER="true"
# Enable teacher intervention dashboard
VITE_FEATURE_INTERVENTION_DASHBOARD="true"
# Enable printable reports (SC-08)
VITE_FEATURE_PRINTABLE_REPORTS="true"
# Enable non-knowledge detector
VITE_FEATURE_NON_KNOWLEDGE_DETECTOR="false"
# Beta features gate
VITE_BETA_FEATURES="false"

# --- Teacher Dashboard ---
# Number of students per page in review queue
VITE_REVIEW_QUEUE_PAGE_SIZE="20"
# Default intervention threshold (mastery %)
VITE_INTERVENTION_THRESHOLD="0.6"
# Enable auto-intervention suggestions
VITE_AUTO_INTERVENTION="false"

# --- Engine Parameters (BKT — Candidate per FR-06) ---
# Initial probability of knowing a skill
VITE_BKT_P_L0="0.25"
# Probability of learning after correct
VITE_BKT_P_T="0.10"
# Probability of slipping (wrong → correct by mistake)
VITE_BKT_P_G="0.10"
# Initial probability of knowing before assessment
VITE_BKT_P_S0="0.35"

# --- Mastery Thresholds ---
# Minimum mastery to consider a skill "known"
VITE_MASTERY_KNOWN_THRESHOLD="0.85"
# Minimum mastery before remediation
VITE_MASTERY_REMEDIATION_THRESHOLD="0.70"
# Mastery improvement target per session
VITE_MASTERY_TARGET_PER_SESSION="0.05"

# --- Item Selection ---
# Recent item window (minutes) — FR-24
VITE_RECENT_ITEM_WINDOW_MINUTES="15"
# Maximum items per session (0 = unlimited)
VITE_MAX_ITEMS_PER_SESSION="0"
# Item exposure warning threshold
VITE_EXPOSURE_WARNING_THRESHOLD="0.85"

# --- Sync Timing ---
# WebRTC connection timeout (ms)
VITE_WEBRTC_CONNECT_TIMEOUT_MS="10000"
# File export batch size
VITE_FILE_EXPORT_BATCH_SIZE="100"
# Evidence merge deduplication window (ms)
VITE_MERGE_DEDUP_WINDOW_MS="60000"

# --- Logging & Debug ---
VITE_LOG_LEVEL="info"
# Possible values: "debug" | "info" | "warn" | "error"
VITE_ENABLE_ANALYTICS="false"
VITE_SENTRY_DSN=""

# --- Content Pipeline (build-time only) ---
# Content pipeline API URL
CONTENT_PIPELINE_API_URL="http://localhost:4000"
# Content export format: "installable" | "streaming"
CONTENT_EXPORT_FORMAT="installable"
