**`gateway.config.yml` mẫu:**

```yaml
http:
  port: 8080
apiEndpoints:
  auth:    { paths: '/api/auth/*' }
  bkt:     { paths: '/api/bkt/*' }
  class:   { paths: '/api/class/*' }
  content: { paths: '/api/content/*' }
  sync:    { paths: '/api/sync/*' }
serviceEndpoints:
  svc-auth:    { url: 'http://svc-auth:3001' }
  svc-bkt:     { url: 'http://svc-bkt:3002' }
  svc-class:   { url: 'http://svc-class:3003' }
  svc-content: { url: 'http://svc-content:3004' }
  svc-sync:    { url: 'http://svc-sync:3005' }
pipelines:
  default:
    apiEndpoints: [auth, bkt, class, content, sync]
    policies:
      - cors
      - rate-limit
      - jwt        # ← Verify tại gateway, KHÔNG re-verify ở service
      - proxy
```

