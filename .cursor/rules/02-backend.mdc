## 🔗 Inter-Service Communication Pattern

```typescript
// ✅ ĐÚNG: Dùng Consul + Circuit Breaker
import { Consul } from '@service/shared/consul-client';
import { createBreaker } from '@service/shared/circuit-breaker';

const breaker = createBreaker('svc-auth', async (path: string, init?: RequestInit) => {
  const baseUrl = await Consul.resolve('svc-auth');
  return fetch(`${baseUrl}${path}`, init);
}, { timeout: 3000, errorThresholdPercentage: 50 });

// Trong service:
const verifyResult = await breaker.fire('/api/auth/verify', {
  method: 'POST',
  body: JSON.stringify({ token }),
  headers: { 'Content-Type': 'application/json' },
});
```

```typescript
// ❌ SAI: Hardcode URL, không có circuit breaker
const response = await fetch('http://svc-auth:3001/api/auth/verify', { ... });
```

